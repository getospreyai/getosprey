# Neon / Vercel Postgres connection string.
# On Vercel: added automatically when you attach a Neon database (Storage tab).
# Locally: copy this file to .env.local and paste your Neon *pooled* connection string.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js (next-auth v5) session signing secret.
# Generate with: openssl rand -base64 32
# On Vercel: set in Project Settings > Environment Variables.
AUTH_SECRET=""

# Telegram bot token from @BotFather (same bot as local dev: @OspreyAlphaBot).
# Used by /api/telegram (send/receive) and /api/cron/scan (deliver verdicts).
TELEGRAM_BOT_TOKEN=""

# Shared secret verified against the `x-telegram-bot-api-secret-token` header
# on inbound webhook calls, so only Telegram can hit /api/telegram.
# Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=""

# Shared secret verified against the `Authorization: Bearer <value>` header
# on /api/cron/scan, so only the Vercel Cron Job can trigger a scan.
# Generate with: openssl rand -hex 24
CRON_SECRET=""

# RentCast API key (https://developers.rentcast.io/) — powers the daily
# listings pull and per-listing rent estimates in /api/cron/scan.
RENTCAST_API_KEY=""

# Opt-in gate for RentCast market scans (cron + onboarding's initial scan).
# Anything other than "true" pauses scans with zero dashboard work; set to
# "true" once the RentCast plan is upgraded to re-enable.
RENTCAST_ENABLED=""

# OpenRouter API key (https://openrouter.ai/keys) — powers Telegram
# plain-English replies and grounded Q&A via free models. Required for those;
# without it the bot still handles A / P / S / HELP via the deterministic
# fast-path.
OPENROUTER_API_KEY=""

# OpenRouter model id override. Optional — defaults to openai/gpt-oss-20b:free.
OSPREY_LLM_MODEL=""

# Manual override for the daily scan's market(s). Optional — by default the
# cron derives markets from onboarded profiles' buy boxes (nationwide). Set
# OSPREY_STATE (OSPREY_CITY optional, narrows to one city) to scan only that
# one market instead — an escape hatch, not the normal path.
OSPREY_CITY=""
OSPREY_STATE=""

# Cap on distinct markets scanned per cron run when derived from profiles
# (ignored when OSPREY_STATE overrides to a single market). Each market is a
# full paginated RentCast pull, so cost scales linearly with this number.
# Optional — defaults to 5.
OSPREY_MAX_MARKETS=""

# Agent & brokerage accounts (docs/AGENT-ACCOUNTS-PLAN.md). Set to "true" to
# expose the /clients roster, farm markets, client invites, and claiming.
#
# The flag gates VISIBILITY only — resolveScope() enforces access regardless,
# so flipping this on by mistake must not grant anyone data they could not
# already reach. Left unset, the whole feature ships dark and a rollback is an
# env-var change rather than a revert.
#
# DO NOT set this in production until ship gate #5 is met: the reviewed
# Privacy Policy + ToS update and a recorded consent step
# (docs/AGENT-ACCOUNTS-PLAN.md §9a). src/lib/legal.ts POLICY_VERSION is the
# programmatic half of that gate — the claim path refuses to run while it
# reads "PROVISIONAL", and a test fails if this flag is "true" while it does.
OSPREY_AGENT_ACCOUNTS=""
